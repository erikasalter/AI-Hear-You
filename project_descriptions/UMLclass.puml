@startuml "Class_UML"



DatabaseController ^.. UserDataController: <<extends>>

abstract class DatabaseController {
    - fileName: String
    + DatabaseController(fileName: String)
    + initDatabase(fileName: String): void
    # <i>loadFromFile()</i>: void
    + closeDatabase(): void
    + restartDatabase(): void
}

class UserDataController {
    + UserDataController(fileName: String)
    + UserDataController()
    # loadFromFile(fileName: String): void
}

@enduml